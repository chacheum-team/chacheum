<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK 읽기 권한: 깜빡이·조향·좌석·와이퍼·전조등·기어 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />

    <!-- NaviHelper: 경로 요청(ROUTE_SEARCH), 남은 거리·시간(ROUTE) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- AAOS 표준 기어(GEAR_SELECTION) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <application
        android:name=".ChacheumApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chacheum">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <!-- 주행 중에도 쓸 수 있는 화면(DO). 주행 중에는 카드 한 장과 한 문장만 보여 줌 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
